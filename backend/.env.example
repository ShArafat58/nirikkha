# Copy this file to .env and fill in real values. Never commit .env.

# ---------- App ----------
APP_NAME=Nirikkha
APP_ENV=development
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# ---------- LLM providers (free tiers) ----------
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- Embeddings (Gemini free tier; raise TPM/RPM if your quota is higher) ----------
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_EMBED_TPM=25000
GEMINI_EMBED_RPM=90

# ---------- Supabase Postgres + pgvector (Connect -> Direct -> Session pooler, port 5432) ----------
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------- Neo4j Aura Free (values from the downloaded credentials .txt) ----------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ---------- SEC EDGAR (required User-Agent: name + email) ----------
SEC_USER_AGENT="Nirikkha Your Name your-email@example.com"