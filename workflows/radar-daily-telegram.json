    {
      "parameters": {
        "jsCode": "const scan = $('Run Radar scan').first().json;\nconst data = $('Get alerts').first().json;\nconst alerts = data.alerts || [];\nconst s = data.summary || {};\nconst rank = { high: 0, medium: 1, low: 2 };\nconst pending = alerts\n  .filter(a => a.status === 'pending' && (a.priority === 'high' || a.priority === 'medium'))\n  .sort((a, b) => rank[a.priority] - rank[b.priority]);\nconst streams = Object.entries(s.by_stream || {}).map(([k, v]) => k + ' ' + v).join(', ');\nconst lines = [];\nlines.push('Nirikkha - Regulatory Change Radar');\nlines.push('Scan checked ' + (scan.saved ?? 0) + ' alerts (' + streams + ')');\nlines.push('Waiting for review: ' + (s.pending ?? 0) + ' | Approved: ' + (s.approved ?? 0) + ' | Rejected: ' + (s.rejected ?? 0));\nlines.push('');\nif (pending.length === 0) {\n  lines.push('No high or medium priority alert is waiting for a decision.');\n} else {\n  lines.push('Needs a human decision:');\n  pending.slice(0, 5).forEach((a, i) => {\n    lines.push((i + 1) + '. [' + a.priority.toUpperCase() + '] ' + (a.company || a.cik || '') + ': ' + a.title);\n    if (a.follow_up) lines.push('   Next step: ' + a.follow_up);\n  });\n  if (pending.length > 5) lines.push('...and ' + (pending.length - 5) + ' more');\n}\nlines.push('');\nlines.push('Approve or reject: https://nirikkha.vercel.app/radar');\nlines.push('No follow-up action starts until a person approves it.');\nreturn [{ json: { text: lines.join('\\n'), pending: pending.length } }];"
      },
